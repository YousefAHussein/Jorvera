# Copy this file to .env and replace the placeholders locally.
# Never commit .env or paste live connection strings into chat/issues.

# Neon pooled URL is suitable for normal app requests. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/DBNAME?sslmode=require

# Use Neon's direct (non-pooler) endpoint for Alembic migrations and verification.
# If omitted, the migration commands fall back to DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/DBNAME?sslmode=require

DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Existing model adapter settings
ACTIVE_MODEL_PROVIDER=mock
OPENAI_MODEL_ID=gpt-4o-mini
GOOGLE_MODEL_ID=gemini-3.1-flash-lite
MODEL_TIMEOUT_SECONDS=10
MAX_MONTHLY_BUDGET_USD=20.00
ENABLE_COST_LOGGING=true
